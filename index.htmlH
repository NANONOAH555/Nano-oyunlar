/* ---------- profil ekranı (DOM) ---------- */
function el(tag, css, txt){ const e = document.createElement(tag); if (css) e.style.cssText = css; if (txt != null) e.textContent = txt; return e; }
function drawParts(c, parts, cx, cy, sc, flip){
  const X = x => cx + x * sc * (flip || 1), Y = y => cy - y * sc;
  parts.forEach(p => { c.fillStyle = p.c; const w = p.z[0] * sc, h = p.z[1] * sc;
    if (p.s === 'box') { c.fillRect(X(p.p[0]) - w / 2, Y(p.p[1]) - h / 2, w, h); }
    else if (p.s === 'sph') { c.beginPath(); c.ellipse(X(p.p[0]), Y(p.p[1]), w, h, 0, 0, 7); c.fill(); }
    else if (p.s === 'cyl') { c.fillRect(X(p.p[0]) - w, Y(p.p[1]) - h / 2, w * 2, h); }
    else if (p.s === 'cone') { c.beginPath(); c.moveTo(X(p.p[0]) - w, Y(p.p[1]) + h / 2); c.lineTo(X(p.p[0]), Y(p.p[1]) - h / 2); c.lineTo(X(p.p[0]) + w, Y(p.p[1]) + h / 2); c.fill(); } });
}
NP.drawParts = drawParts;
function drawLook(cv, look, bodyDef){
  const c = cv.getContext('2d'), W = cv.width, H = cv.height; c.clearRect(0, 0, W, H);
  const col = look.color || bodyDef || '#ff7a59'; const sc = W / 8.6, cx = W / 2, cy = H * .42; const X = x => cx + x * sc, Y = y => cy - y * sc;
  drawParts(c, look.parts.filter(p => p.p[2] < -.5), cx, cy, sc);
  c.fillStyle = col; c.fillRect(X(-.9), Y(-1.1), 1.8 * sc, 2.2 * sc);
  c.fillStyle = 'rgba(0,0,0,.18)'; c.fillRect(X(-.9), Y(-1.1), 1.8 * sc, .3 * sc);
  c.fillStyle = '#f2c7a0'; c.beginPath(); c.arc(X(0), Y(0), sc, 0, 7); c.fill();
  c.fillStyle = '#222'; c.beginPath(); c.arc(X(-.36), Y(.1), .09 * sc, 0, 7); c.arc(X(.36), Y(.1), .09 * sc, 0, 7); c.fill();
  c.strokeStyle = '#7a3b24'; c.lineWidth = 2; c.beginPath(); c.arc(X(0), Y(-.1), .38 * sc, .2, Math.PI - .2); c.stroke();
  drawParts(c, look.parts.filter(p => p.p[2] >= -.5), cx, cy, sc);
}
NP.drawLook = drawLook;
/* ---------- Metrobüs boya / sprey ---------- */
NP.BUS_BODY = ['#f3f5f7', '#ffd54a', '#2f80ed', '#2ecc71', '#ff7a1a', '#ff4fa3', '#9b59b6', '#222831'];
NP.BUS_SPRAY = ['#ff2d95', '#00e5ff', '#7cff3a', '#ffe600', '#ff3b30', '#ffffff', '#111111', '#b388ff'];
NP.BUS_FONTS = ['900 {S}px Impact,"Arial Black",sans-serif', 'italic 700 {S}px "Brush Script MT","Segoe Script","Comic Sans MS",cursive', '800 {S}px "Comic Sans MS","Chalkboard SE","Trebuchet MS",sans-serif'];
NP.BUS_FONT_N = ['Kalın', 'El yazısı', 'Eğlenceli'];
NP.bus = () => { load(); return Object.assign({ text: '', col: '#ff2d95', body: '#f3f5f7', font: 0 }, P.bus || {}); };
NP.setBus = o => { load(); P.bus = { text: String(o.text || '').slice(0, 16), col: o.col, body: o.body, font: o.font | 0 }; save(); };
function hash(str){ let h = 7; for (let i = 0; i < str.length; i++) h = (h * 31 + str.charCodeAt(i)) | 0; return h; }
/* sprey yazısını saydam bir kanvasa (1024x256) çizer */
NP.drawSpray = (cv, o) => {
  const g = cv.getContext('2d'), W = cv.width, H = cv.height; g.clearRect(0, 0, W, H);
  const txt = String(o.text || '').toLocaleUpperCase('tr-TR').slice(0, 16).trim(); if (!txt) return false;
  let size = Math.round(H * .62); const f = () => NP.BUS_FONTS[o.font | 0 % 3].replace('{S}', size);
  g.textAlign = 'center'; g.textBaseline = 'middle'; g.font = f(); while (g.measureText(txt).width > W * .92 && size > 24) { size -= 4; g.font = f(); }
  const cy = H * .42; let seed = Math.abs(hash(txt)) || 1; const rnd = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };
  /* sis */
  g.save(); g.shadowColor = o.col; g.shadowBlur = 26; g.fillStyle = o.col; g.globalAlpha = .55; g.fillText(txt, W / 2, cy); g.restore();
  g.lineJoin = 'round'; g.lineWidth = Math.max(6, size * .09); g.strokeStyle = 'rgba(0,0,0,.65)'; g.strokeText(txt, W / 2, cy);
  g.fillStyle = o.col; g.fillText(txt, W / 2, cy);
  g.globalCompositeOperation = 'source-atop'; g.fillStyle = 'rgba(255,255,255,.28)'; g.fillRect(0, cy - size * .5, W, size * .22); g.globalCompositeOperation = 'source-over';
  /* akıntılar */
  const tw = g.measureText(txt).width, x0 = W / 2 - tw / 2; g.strokeStyle = o.col; g.lineCap = 'round';
  for (let i = 0; i < Math.min(9, txt.length + 2); i++) { const x = x0 + tw * (i + .5) / Math.min(9, txt.length + 2) + (rnd() - .5) * 20, y0 = cy + size * .38, L = 14 + rnd() * size * .45; g.lineWidth = 4 + rnd() * 4; g.beginPath(); g.moveTo(x, y0); g.lineTo(x, y0 + L); g.stroke(); g.fillStyle = o.col; g.beginPath(); g.arc(x, y0 + L + 3, g.lineWidth * .8, 0, 7); g.fill(); }
  /* damlacıklar */
  g.fillStyle = o.col; for (let i = 0; i < 90; i++) { const a = rnd() * 6.28, r = size * (.45 + rnd() * .5); g.globalAlpha = .25 + rnd() * .5; g.beginPath(); g.arc(W / 2 + Math.cos(a) * tw * .5 * (.7 + rnd() * .5), cy + Math.sin(a) * r, 1 + rnd() * 3, 0, 7); g.fill(); } g.globalAlpha = 1;
  return true;
};
function drawBusSide(cv, o){
  const g = cv.getContext('2d'), W = cv.width, H = cv.height; g.clearRect(0, 0, W, H);
  g.fillStyle = '#2a3344'; g.fillRect(0, H - 22, W, 22);
  g.fillStyle = o.body; g.beginPath(); g.moveTo(14, H - 26); g.lineTo(14, 36); g.quadraticCurveTo(14, 20, 34, 20); g.lineTo(W - 34, 20); g.quadraticCurveTo(W - 14, 20, W - 14, 40); g.lineTo(W - 14, H - 26); g.closePath(); g.fill();
  g.fillStyle = 'rgba(0,0,0,.25)'; g.fillRect(14, H - 56, W - 28, 26); g.fillStyle = '#d62828'; g.fillRect(14, H - 62, W - 28, 6);
  g.fillStyle = '#23405c'; [[34, 70], [124, 90], [234, 40], [284, 90], [384, 70]].forEach(([x, w]) => g.fillRect(x, 32, w, 32));
  g.fillStyle = '#2f5d86'; [[100, 20], [358, 20]].forEach(([x, w]) => g.fillRect(x, 32, w, H - 66));
  g.fillStyle = '#111'; [70, 220, 380].forEach(x => { g.beginPath(); g.arc(x, H - 20, 15, 0, 7); g.fill(); g.fillStyle = '#999'; g.beginPath(); g.arc(x, H - 20, 6, 0, 7); g.fill(); g.fillStyle = '#111'; });
  const sp = document.createElement('canvas'); sp.width = 1024; sp.height = 256; if (NP.drawSpray(sp, o)) g.drawImage(sp, 150, H - 108, 220, 52);
  g.fillStyle = '#c21f1f'; g.font = 'bold 12px Arial'; g.textAlign = 'center'; g.fillText('METROBÜS', 262, H - 38);
}
NP.busEditor = (host, onChange) => {
  const o = NP.bus(); const wrap = el('div', 'background:#121a33;border:1px solid #2b3a78;border-radius:16px;padding:14px;max-width:560px;margin:0 auto;text-align:left;color:#eef1ff');
  wrap.appendChild(el('div', 'font-weight:800;color:#ffc83d;margin-bottom:8px', '🚌 Metrobüsünü boya ve yaz'));
  const cv = document.createElement('canvas'); cv.width = 440; cv.height = 130; cv.style.cssText = 'position:relative!important;left:auto!important;top:auto!important;pointer-events:none;display:block;width:100%;border-radius:12px;background:linear-gradient(#26356b,#101830);margin-bottom:10px'; wrap.appendChild(cv);
  const inp = document.createElement('input'); inp.type = 'text'; inp.maxLength = 16; inp.placeholder = 'Sprey yazısı (en çok 16 harf)'; inp.value = o.text; inp.style.cssText = 'width:100%;font:inherit;font-size:18px;padding:10px 12px;border-radius:10px;border:2px solid #2b3a78;background:#0a0f1f;color:#fff;margin-bottom:10px;box-sizing:border-box'; wrap.appendChild(inp);
  const sw = (title, list, key) => { wrap.appendChild(el('div', 'font-size:13px;color:#9aa6d6;margin:6px 0 4px', title)); const row = el('div', 'display:flex;gap:8px;flex-wrap:wrap'); row._b = []; list.forEach(c => { const b = el('button', 'width:44px;height:44px;border-radius:50%;border:3px solid #fff0;background:' + c + ';cursor:pointer'); b.onclick = () => { o[key] = c; upd(); }; row._b.push([b, c]); row.appendChild(b); }); wrap.appendChild(row); return row; };
  const rowS = sw('Sprey rengi', NP.BUS_SPRAY, 'col'), rowB = sw('Otobüs rengi', NP.BUS_BODY, 'body');
  wrap.appendChild(el('div', 'font-size:13px;color:#9aa6d6;margin:8px 0 4px', 'Yazı stili')); const rowF = el('div', 'display:flex;gap:8px;flex-wrap:wrap');
  NP.BUS_FONT_N.forEach((n, i) => { const b = el('button', 'font:inherit;font-weight:700;min-height:44px;padding:4px 14px;border-radius:10px;border:2px solid #2b3a78;background:#0a0f1f;color:#fff;cursor:pointer', n); b.onclick = () => { o.font = i; upd(); }; rowF.appendChild(b); }); wrap.appendChild(rowF);
  function upd(){ o.text = inp.value; NP.setBus(o); drawBusSide(cv, o); rowS._b.forEach(([b, c]) => b.style.borderColor = c === o.col ? '#fff' : '#fff0'); rowB._b.forEach(([b, c]) => b.style.borderColor = c === o.body ? '#fff' : '#fff0'); [].forEach.call(rowF.children, (b, i) => b.style.borderColor = i === (o.font | 0) ? '#ffc83d' : '#2b3a78'); if (onChange) onChange(o); }
  inp.addEventListener('input', upd); host.appendChild(wrap); upd(); return wrap;
};

let shopEl = null, tab = 'kostum';
NP.openProfile = (onClose) => {
  load(); if (shopEl) shopEl.remove();
  const root = shopEl = el('div', 'position:fixed;inset:0;z-index:2147482000;background:#060a1c;color:#eef1ff;font:16px/1.4 system-ui,"Segoe UI",Roboto,Arial,sans-serif;overflow:auto;-webkit-overflow-scrolling:touch');
  const wrap = el('div', 'max-width:980px;margin:0 auto;padding:16px 16px 40px'); root.appendChild(wrap);
  const top = el('div', 'display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;margin-bottom:12px');
  const h = el('div', 'font-size:26px;font-weight:800', '👤 ' + P.name); h.style.cursor = 'pointer'; h.title = 'Adı değiştir';
  h.onclick = () => { let n = null; try { n = prompt('Adın ne?', P.name); } catch (_) {} if (n && n.trim()) { P.name = n.trim().slice(0, 14); save(); render(); } };
  const coin = el('div', 'font-size:22px;font-weight:800;color:#ffc83d', '🪙 ' + P.coins);
  const close = el('button', 'font:inherit;font-weight:700;font-size:18px;min-height:48px;padding:6px 18px;border-radius:12px;border:0;background:#ffb300;color:#222;cursor:pointer', '✕ Kapat');
  close.onclick = () => { root.remove(); shopEl = null; if (onClose) onClose(); };
  top.appendChild(h); top.appendChild(coin); top.appendChild(close); wrap.appendChild(top);
  const tabs = el('div', 'display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap');
  [['kostum', '🎩 Kostüm'], ['bus', '🚌 Metrobüs'], ['gorev', '🎯 Günlük'], ['rozet', '🏅 Rozetler'], ['rekor', '🏆 Rekorlar'], ['kayit', '💾 Kayıt']].forEach(([id, l]) => { const b = el('button', 'font:inherit;font-weight:700;min-height:48px;padding:6px 18px;border-radius:12px;border:2px solid ' + (tab === id ? '#ffc83d' : '#2b3a78') + ';background:' + (tab === id ? '#ffc83d' : '#121a33') + ';color:' + (tab === id ? '#222' : '#eef1ff') + ';cursor:pointer', l); b.onclick = () => { tab = id; render(); }; tabs.appendChild(b); });
  wrap.appendChild(tabs);
  const body = el('div'); wrap.appendChild(body);
  function render(){ load(); h.textContent = '👤 ' + P.name; coin.textContent = '🪙 ' + P.coins; tabs.childNodes.forEach((b, i) => { const id = ['kostum', 'bus', 'gorev', 'rozet', 'rekor', 'kayit'][i]; b.style.background = tab === id ? '#ffc83d' : '#121a33'; b.style.color = tab === id ? '#222' : '#eef1ff'; b.style.borderColor = tab === id ? '#ffc83d' : '#2b3a78'; }); body.innerHTML = ''; ({ kostum: rKostum, bus: rBus, gorev: rGorev, rozet: rRozet, rekor: rRekor, kayit: rKayit })[tab](); }
  let pv = {}; /* denenen (henüz alınmamış) parçalar */
  function rKostum(){
    const g = el('div'); const box = el('div', 'background:#0d1530;border:1px solid #2b3a78;border-radius:16px;padding:10px;display:flex;gap:14px;align-items:center;position:sticky;top:0;z-index:3;margin-bottom:12px;box-shadow:0 8px 20px rgba(0,0,0,.5)');
    const cv = document.createElement('canvas'); cv.width = 170; cv.height = 210; cv.style.cssText = 'position:relative!important;left:auto!important;top:auto!important;pointer-events:none;display:block;width:130px;height:auto;flex:none;border-radius:12px;background:linear-gradient(#26356b,#101830)'; box.appendChild(cv);
    const info = el('div', 'flex:1;min-width:0;text-align:left'); box.appendChild(info);
    drawLook(cv, NP.look(pv));
    const keys = Object.keys(pv), tot = keys.reduce((a, k) => a + (P.owned.includes(pv[k]) ? 0 : NP.item(pv[k]).p), 0);
    if (keys.length) {
      info.appendChild(el('div', 'font-weight:700;color:#ffd98a', 'Üstünde deniyorsun: ' + keys.map(k => NP.item(pv[k]).n).join(', ')));
      const row = el('div', 'display:flex;gap:8px;margin-top:8px;flex-wrap:wrap');
      const buy = el('button', 'font:inherit;font-weight:800;min-height:48px;padding:6px 16px;border-radius:12px;border:0;background:' + (P.coins >= tot ? '#46d37f' : '#555') + ';color:#111;cursor:pointer', tot ? 'Satın al 🪙 ' + tot : 'Giy');
      buy.onclick = () => { if (P.coins < tot) { NP.sfx('bad'); NP.toast('Yetmiyor', '🪙', (tot - P.coins) + ' 🪙 daha lazım'); return; } keys.forEach(k => { const id = pv[k]; if (!P.owned.includes(id)) { NP.buy(id); NP.badge('gn_giy'); } NP.wear(k, id); }); pv = {}; render(); };
      const no = el('button', 'font:inherit;font-weight:700;min-height:48px;padding:6px 16px;border-radius:12px;border:2px solid #2b3a78;background:#121a33;color:#eef1ff;cursor:pointer', 'Vazgeç');
      no.onclick = () => { pv = {}; render(); };
      row.appendChild(buy); row.appendChild(no); info.appendChild(row);
    } else info.appendChild(el('div', 'color:#cfd8ff;font-size:15px', 'Bir kostüme dokun: önce üstünde görürsün, beğenirsen alırsın.'));
    g.appendChild(box);
    const list = el('div'); g.appendChild(list);
    ['hat', 'face', 'neck', 'back', 'color'].forEach(slot => {
      list.appendChild(el('div', 'font-weight:800;color:#ffc83d;margin:4px 0 8px;letter-spacing:.06em;text-transform:uppercase;font-size:14px', NP.SLOT_N[slot]));
      const row = el('div', 'display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:16px');
      if (slot !== 'color') { const none = el('button', 'font:inherit;min-height:64px;border-radius:12px;border:2px solid ' + (!P.worn[slot] && !(slot in pv) ? '#46d37f' : '#2b3a78') + ';background:#121a33;color:#eef1ff;cursor:pointer', 'Yok'); none.onclick = () => { delete pv[slot]; NP.wear(slot, null); render(); }; row.appendChild(none); }
      NP.SHOP[slot].forEach(it => {
        const own = P.owned.includes(it.id), on = P.worn[slot] === it.id && !(slot in pv), tr = pv[slot] === it.id;
        const b = el('button', 'font:inherit;min-height:64px;border-radius:12px;border:2px solid ' + (tr ? '#ffc83d' : on ? '#46d37f' : own ? '#4aa8ff' : '#2b3a78') + ';background:' + (tr ? '#2a2a12' : '#121a33') + ';color:#eef1ff;cursor:pointer;padding:6px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px');
        if (slot === 'color') b.appendChild(el('div', 'width:26px;height:26px;border-radius:50%;border:2px solid #fff;background:' + (it.col || 'linear-gradient(135deg,#ff7a59,#ffc83d)'), ''));
        b.appendChild(el('div', 'font-weight:700', it.n)); b.appendChild(el('div', 'font-size:13px;color:' + (tr ? '#ffc83d' : on ? '#46d37f' : own ? '#4aa8ff' : '#ffc83d'), tr ? '👀 Deniyorsun' : on ? '✓ Giyiyor' : own ? 'Giy' : '🪙 ' + it.p + ' · dene'));
        b.onclick = () => { if (own) { delete pv[slot]; NP.wear(slot, it.id); } else { pv[slot] = it.id; NP.sfx('pick'); } render(); };
        row.appendChild(b);
      }); list.appendChild(row);
    });
    body.appendChild(g);
    if (!document.getElementById('np-css')) { const s = el('style'); s.id = 'np-css'; s.textContent = '@media(max-width:640px){.np-g{grid-template-columns:1fr!important}.np-g>div:first-child{position:static!important}}'; document.head.appendChild(s); }
  }
  function rBus(){ NP.busEditor(body, null); }
  function rRozet(){
    const ids = Object.keys(NP.BADGES), got = ids.filter(i => P.badges[i]).length;
    body.appendChild(el('div', 'color:#9aa6d6;margin-bottom:10px', got + ' / ' + ids.length + ' rozet · her rozet para verir'));
    const g = el('div', 'display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px');
    ids.sort((a, b) => (P.badges[b] ? 1 : 0) - (P.badges[a] ? 1 : 0)).forEach(id => { const b = NP.BADGES[id], has = !!P.badges[id];
      const c = el('div', 'background:#121a33;border:2px solid ' + (has ? '#ffc83d' : '#2b3a78') + ';border-radius:12px;padding:10px;display:flex;gap:10px;align-items:center;' + (has ? '' : 'opacity:.5'));
      c.appendChild(el('div', 'font-size:30px;filter:' + (has ? 'none' : 'grayscale(1)'), b.i)); const t = el('div'); t.appendChild(el('div', 'font-weight:700', b.n)); t.appendChild(el('div', 'font-size:13px;color:#9aa6d6', b.d)); t.appendChild(el('div', 'font-size:13px;color:#ffc83d', '🪙 ' + b.c)); c.appendChild(t); g.appendChild(c); });
    body.appendChild(g);
  }
  function ask(msg, yes, onYes){
    const ov = el('div', 'position:fixed;inset:0;z-index:2147483300;background:rgba(3,6,18,.85);display:flex;align-items:center;justify-content:center;padding:16px');
    const bx = el('div', 'background:#101a38;border:2px solid #ffc83d;border-radius:18px;max-width:440px;width:100%;padding:20px;color:#eef1ff;text-align:center');
    bx.appendChild(el('div', 'font-size:22px;font-weight:800;margin-bottom:8px', 'Emin misin?')); bx.appendChild(el('div', 'color:#c7d0f5;margin-bottom:16px', msg));
    const row = el('div', 'display:flex;gap:10px'); const no = el('button', 'flex:1;font:inherit;font-weight:800;font-size:18px;min-height:52px;border-radius:12px;border:0;background:#cfd8dc;color:#222;cursor:pointer', 'Hayır'); const ye = el('button', 'flex:1;font:inherit;font-weight:800;font-size:18px;min-height:52px;border-radius:12px;border:0;background:#ffb300;color:#222;cursor:pointer', yes);
    no.onclick = () => ov.remove(); ye.onclick = () => { ov.remove(); onYes(); }; row.appendChild(no); row.appendChild(ye); bx.appendChild(row); ov.appendChild(bx); document.body.appendChild(ov);
  }
  function rGorev(){
    const d = NP.daily(); const box = el('div', 'background:#121a33;border:2px solid #ffc83d;border-radius:14px;padding:14px;margin-bottom:14px');
    box.appendChild(el('div', 'font-size:20px;font-weight:800', '🎁 Günlük ödül'));
    box.appendChild(el('div', 'color:#9aa6d6;margin:2px 0 10px', 'Seri: ' + d.streak + ' gün · her gün girince ödül artar (en çok 6 gün).'));
    const b = el('button', 'font:inherit;font-weight:800;font-size:18px;min-height:52px;padding:6px 22px;border-radius:12px;border:0;cursor:pointer;background:' + (d.claimed ? '#2b3a78' : '#ffb300') + ';color:' + (d.claimed ? '#9aa6d6' : '#222'), d.claimed ? 'Bugünkü ödül alındı ✓' : 'Ödülü al: +' + NP.dailyReward() + ' 🪙');
    if (!d.claimed) b.onclick = () => { NP.dailyClaim(); render(); }; box.appendChild(b); body.appendChild(box);
    body.appendChild(el('div', 'font-size:20px;font-weight:800;margin:0 0 8px', '🎯 Bugünün görevleri'));
    d.qs.forEach((q, i) => { const Q = NP.questInfo(q); const c = el('div', 'background:#121a33;border:1px solid ' + (q.done ? '#ffc83d' : '#2b3a78') + ';border-radius:12px;padding:10px;margin-bottom:8px;display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap');
      const t = el('div'); t.appendChild(el('div', 'font-weight:700', Q.x)); t.appendChild(el('div', 'font-size:13px;color:#9aa6d6', q.p + ' / ' + Q.n + ' · ödül ' + Q.r + ' 🪙')); c.appendChild(t);
      const bt = el('button', 'font:inherit;font-weight:700;min-height:44px;padding:4px 16px;border-radius:10px;border:0;cursor:pointer;background:' + (q.got ? '#2b3a78' : q.done ? '#ffb300' : '#1a2448') + ';color:' + (q.got ? '#9aa6d6' : q.done ? '#222' : '#6f7bb0'), q.got ? 'Alındı ✓' : q.done ? 'Al +' + Q.r : 'Devam ediyor');
      if (q.done && !q.got) bt.onclick = () => { NP.questClaim(i); render(); }; c.appendChild(bt); body.appendChild(c); });
    body.appendChild(el('div', 'font-size:13px;color:#9aa6d6;margin-top:6px', 'Görevler her gün yenilenir. Oyunu bitirince (ya da bitiş ekranına gelince) sayılır.'));
  }
  function rKayit(){
    const box = el('div', 'background:#121a33;border:1px solid #2b3a78;border-radius:14px;padding:14px;margin-bottom:12px');
    box.appendChild(el('div', 'font-size:20px;font-weight:800', '💾 Kaydını yedekle'));
    box.appendChild(el('div', 'color:#9aa6d6;margin:4px 0 12px', 'Para, rozet, rekor, kostüm ve tüm oyun kayıtların bir dosyaya indirilir. Başka cihaza ya da flash belleğe taşıyabilirsin.'));
    const ex = el('button', 'font:inherit;font-weight:800;font-size:18px;min-height:52px;padding:6px 22px;border-radius:12px;border:0;background:#ffb300;color:#222;cursor:pointer', '⬇ Kaydı indir');
    ex.onclick = () => ask('Kaydın bir dosya olarak indirilecek.', 'Evet, indir', () => {
      const data = {}; try { for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k && k.indexOf('nano:') === 0) data[k] = localStorage.getItem(k); } } catch (_) {}
      const blob = new Blob([JSON.stringify({ nano: 1, t: Date.now(), data })], { type: 'application/json' }); const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'nano-kayit-' + NP.dayKey() + '.json'; document.body.appendChild(a); a.click(); setTimeout(() => { a.remove(); URL.revokeObjectURL(a.href); }, 1500); NP.toast('Kayıt indirildi', '💾', 'Dosyayı güvenli bir yerde sakla');
    });
    box.appendChild(ex); body.appendChild(box);
    const b2 = el('div', 'background:#121a33;border:1px solid #2b3a78;border-radius:14px;padding:14px');
    b2.appendChild(el('div', 'font-size:20px;font-weight:800', '📂 Kayıt yükle'));
    b2.appendChild(el('div', 'color:#9aa6d6;margin:4px 0 12px', 'Daha önce indirdiğin kayıt dosyasını seç. Bu cihazdaki kaydın silinir, dosyadaki kayıt gelir.'));
    const inp = document.createElement('input'); inp.type = 'file'; inp.accept = '.json,application/json'; inp.style.display = 'none';
    const im = el('button', 'font:inherit;font-weight:800;font-size:18px;min-height:52px;padding:6px 22px;border-radius:12px;border:0;background:#9fb0ff;color:#222;cursor:pointer', '⬆ Dosya seç');
    im.onclick = () => inp.click();
    inp.onchange = () => { const f = inp.files && inp.files[0]; if (!f) return; const rd = new FileReader(); rd.onload = () => {
      let o = null; try { o = JSON.parse(rd.result); } catch (_) {} if (!o || o.nano !== 1 || !o.data || typeof o.data !== 'object') { NP.sfx('bad'); NP.toast('Dosya olmadı', '⚠️', 'Bu bir Nano kayıt dosyası değil'); return; }
      ask('Bu cihazdaki mevcut kaydın silinecek ve dosyadaki kayıt gelecek. Geri dönüş yok.', 'Evet, yükle', () => { try { const del = []; for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k && k.indexOf('nano:') === 0 && k !== 'nano:seen') del.push(k); } del.forEach(k => localStorage.removeItem(k)); Object.keys(o.data).forEach(k => { if (k.indexOf('nano:') === 0 && k !== 'nano:seen' && typeof o.data[k] === 'string') localStorage.setItem(k, o.data[k]); }); } catch (_) {} NP.toast('Kayıt yüklendi', '✅', 'Sayfa yenileniyor'); setTimeout(() => location.reload(), 900); }); };
      rd.readAsText(f); inp.value = ''; };
    b2.appendChild(im); b2.appendChild(inp); body.appendChild(b2);
  }
  function rRekor(){
    const names = { metrobus: 'Metrobüs', kacak: 'Kaçak', sifir: 'Sıfır Durak', liman: 'Martı Nöbeti', poyraz: 'Poyraz', cay: 'Çay Ocağı', yol: 'Yol Yarışı', poyraz2: 'Poyraz · 2 oyuncu', sehir: 'Mahalle Kur (nüfus)', balik: 'Balıkçı' };
    const ks = Object.keys(P.rec); if (!ks.length) { body.appendChild(el('div', 'color:#9aa6d6', 'Henüz rekor yok. Bir oyun oyna!')); return; }
    const g = el('div', 'display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px');
    ks.sort().forEach(k => { const [gm, df] = k.split(':'); const c = el('div', 'background:#121a33;border:1px solid #2b3a78;border-radius:12px;padding:10px'); c.appendChild(el('div', 'font-weight:700', (names[gm] || gm) + (df !== '-' ? ' · ' + df : ''))); c.appendChild(el('div', 'font-size:24px;font-weight:800;color:#ffc83d', '🏆 ' + P.rec[k])); g.appendChild(c); });
    body.appendChild(g);
  }
  render(); document.body.appendChild(root);
};
NP.played = g => { load(); P.stat['pl_' + g] = 1; save(); if (['metrobus', 'kacak', 'sifir', 'liman', 'poyraz', 'cay', 'yol', 'sehir'].every(k => P.stat['pl_' + k])) NP.badge('gn_hepsi'); };
/* ---------- "Güncelleme geldi" penceresi: her sürüm için yalnızca bir kez ---------- */
NP.whatsNew = (ver, title, items) => {
  try { if (localStorage.getItem('nano:seen') === ver) return; } catch (_) { return; }
  const go = () => {
    const root = el('div', 'position:fixed;inset:0;z-index:2147483100;background:rgba(3,6,18,.9);display:flex;align-items:center;justify-content:center;padding:16px;font-family:system-ui,"Segoe UI",Roboto,Arial,sans-serif');
    const box = el('div', 'background:#101a38;border:2px solid #ffc83d;border-radius:20px;max-width:560px;width:100%;max-height:92vh;overflow:auto;padding:20px 20px 18px;color:#eef1ff;box-shadow:0 20px 60px rgba(0,0,0,.6)');
    box.appendChild(el('div', 'font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#ffc83d;font-weight:800', '🎉 Güncelleme'));
    box.appendChild(el('div', 'font-size:28px;font-weight:800;margin:4px 0 12px', title));
    items.forEach(it => { const r = el('div', 'display:flex;gap:12px;align-items:flex-start;margin:0 0 10px'); r.appendChild(el('div', 'font-size:26px;line-height:1.1;flex:none', it[0])); const t = el('div'); t.appendChild(el('div', 'font-weight:700', it[1])); t.appendChild(el('div', 'font-size:14px;color:#aeb9e6', it[2])); r.appendChild(t); box.appendChild(r); });
    const ok = el('button', 'font:inherit;font-weight:800;font-size:19px;min-height:54px;width:100%;margin-top:8px;position:sticky;bottom:0;border-radius:14px;border:0;background:#ffb300;color:#222;cursor:pointer', 'Tamam, başlayalım!');
    ok.onclick = () => { try { localStorage.setItem('nano:seen', ver); } catch (_) {} root.remove(); NP.sfx('ok'); };
    box.appendChild(ok); root.appendChild(box); document.body.appendChild(root); NP.sfx('badge');
  };
  if (document.body) go(); else addEventListener('DOMContentLoaded', go);
};
})();
</script>
<script>
var GAMES=[

 {id:'metrobus',href:'metrobus.html',c:'#ff5a4f',tag:'Simülasyon',n:'Metrobüs',d:'Beylikdüzü ile Zincirlikuyu arasında sefer yap. Yolcuları al, durakları anons et, kasaya para topla. Kaza yaparsan kasadan 50 TL gider.',keys:'Bitirince “Sonraki tur” seni Kaçak’a götürür.',lib:1,
  svg:'<rect width="260" height="150" fill="#27324f"/><rect y="104" width="260" height="46" fill="#1b2238"/><rect x="0" y="126" width="260" height="4" fill="#ffc83d"/><rect x="30" y="52" width="200" height="56" rx="8" fill="#ff5a4f"/><rect x="42" y="60" width="34" height="22" fill="#cfe8ff"/><rect x="82" y="60" width="34" height="22" fill="#cfe8ff"/><rect x="122" y="60" width="34" height="22" fill="#cfe8ff"/><rect x="162" y="60" width="56" height="30" fill="#9fd0ff"/><circle cx="66" cy="110" r="10" fill="#111"/><circle cx="190" cy="110" r="10" fill="#111"/><rect x="36" y="94" width="188" height="6" fill="#fff" opacity=".6"/>'},
 {id:'kacak',href:'kacak.html',c:'#ffc83d',tag:'Aksiyon · 35 görev',n:'Kaçak',d:'Tekstilkent’ten metroya, Mahmutbey, Kayaşehir, İstanbul Havalimanı… Bir uçak çal, polisten kaç, gizemli bir yabancıya güven ve geceyi atlat.',keys:'Yürü, koş, araba sür, uçak kullan.',lib:1,
  svg:'<rect width="260" height="150" fill="#1a2140"/><circle cx="210" cy="36" r="16" fill="#ffe9a8"/><rect x="20" y="60" width="30" height="70" fill="#2a3560"/><rect x="58" y="40" width="34" height="90" fill="#323e70"/><rect x="100" y="70" width="28" height="60" fill="#2a3560"/><rect y="118" width="260" height="32" fill="#10142a"/><rect x="150" y="96" width="80" height="26" rx="6" fill="#ffc83d"/><rect x="164" y="84" width="46" height="18" rx="5" fill="#ffd96b"/><circle cx="170" cy="124" r="8" fill="#000"/><circle cx="214" cy="124" r="8" fill="#000"/><rect x="0" y="136" width="260" height="3" fill="#fff" opacity=".4"/>'},
{id:'kacak2',href:'kacak2.html',c:'#ffcf33',tag:'2 kişilik · bölünmüş ekran',df:0,n:'Kaçak: 2 Oyuncu',d:'Kaçak’ı bilgisayarda ya da akıllı tahtada aynı klavyede iki kişi oyna (telefonda çalışmaz). Ekran ikiye bölünür. Her yerde birbirinizi görürsünüz: istasyonda, trende, şehirde, evde, uçakta. 35 görev! Kim önce bitirecek? Bazı görevleri birlikte yaparsınız.',keys:'1. oyuncu: W A S D, E. 2. oyuncu: ok tuşları, Enter. Klavye gerekir.',
  svg:'<rect width="260" height="150" fill="#1b2433"/><rect x="0" y="0" width="128" height="150" fill="#27384f"/><rect x="132" y="0" width="128" height="150" fill="#2f2a3d"/><rect x="0" y="100" width="128" height="50" fill="#3a3f47"/><rect x="132" y="100" width="128" height="50" fill="#3a3f47"/><circle cx="64" cy="80" r="11" fill="#e53935"/><rect x="55" y="90" width="18" height="24" rx="4" fill="#e53935"/><circle cx="196" cy="80" r="11" fill="#1e88e5"/><rect x="187" y="90" width="18" height="24" rx="4" fill="#1e88e5"/><rect x="128" width="4" height="150" fill="#ffcf33"/><text x="64" y="26" fill="#fff" font-size="14" font-weight="700" text-anchor="middle" font-family="sans-serif">1</text><text x="196" y="26" fill="#fff" font-size="14" font-weight="700" text-anchor="middle" font-family="sans-serif">2</text>'},
 {id:'sifir',href:'sifir-durak.html',c:'#46d37f',tag:'Macera · 6 bölüm',df:1,n:'Sıfır Durak',d:'Son seferde anons “Sıradaki durak: Sıfır” diyor. Haritada olmayan bir durakta, unutulmuş şeylerin arasında bir bilet için üç parça ve üç mühür topla. Altı bölüm, gizli sonlar.',keys:'Dokun ya da tıkla. H ipucu, N notlar, D noktalar.',
  svg:'<rect width="260" height="150" fill="#0e2a22"/><path d="M30 150V70a50 50 0 0 1 100 0v80z" fill="#020403"/><rect x="150" y="28" width="90" height="26" rx="4" fill="#8e1b1b"/><text x="195" y="47" fill="#fff" font-size="17" font-weight="700" text-anchor="middle" font-family="sans-serif">SIFIR</text><rect x="0" y="118" width="260" height="32" fill="#17201c"/><rect x="150" y="76" width="20" height="46" fill="#2c3a58"/><circle cx="160" cy="68" r="9" fill="#e0b890"/><circle cx="184" cy="100" r="11" fill="#ffd54f" opacity=".6"/>'},
 {id:'liman',href:'liman.html',c:'#4aa8ff',tag:'Kule savunma · 4 harita',df:1,n:'Martı Nöbeti',d:'Boğaz’ın martıları Altın Simit’in peşinde. Simitçi, çaycı, balıkçı, fener ve düdük yerleştir; vapuru koru.',keys:'1-5 kule seç, Boşluk dalga başlat, F hız, P duraklat.',
  svg:'<rect width="260" height="150" fill="#2f78a8"/><path d="M-10 60H170V120H270" stroke="#a58559" stroke-width="30" fill="none"/><circle cx="60" cy="100" r="14" fill="#e53935"/><circle cx="120" cy="30" r="14" fill="#1e88e5"/><g fill="#fff"><path d="M30 55l14-10 14 10-14 4z"/><path d="M100 60l14-10 14 10-14 4z"/><path d="M165 72l14-10 14 10-14 4z"/></g><rect x="200" y="96" width="60" height="30" rx="5" fill="#263238"/><circle cx="232" cy="118" r="8" fill="none" stroke="#ffd600" stroke-width="4"/>'},
 {id:'poyraz',href:'poyraz.html',c:'#a47bff',tag:'Platform · 6 bölüm',df:1,n:'Poyraz',d:'Küçük bulut postacısı İstanbul’un kayıp mektuplarını taşıyor. Çatılar, metro tüneli, bulutlar, fırtına, liman ve sis.',keys:'Ok tuşları ya da A D, Boşluk zıpla. Düşmanın üstüne zıplayarak yen.',
  svg:'<rect width="260" height="150" fill="#7ec8f2"/><ellipse cx="60" cy="36" rx="34" ry="12" fill="#fff" opacity=".85"/><ellipse cx="190" cy="52" rx="40" ry="12" fill="#fff" opacity=".85"/><rect y="112" width="110" height="38" fill="#8a6a4a"/><rect y="106" width="110" height="9" fill="#5fae4f"/><rect x="160" y="112" width="100" height="38" fill="#8a6a4a"/><rect x="160" y="106" width="100" height="9" fill="#5fae4f"/><rect x="62" y="68" width="18" height="26" fill="#1e88e5"/><circle cx="71" cy="62" r="8" fill="#ffcc80"/><rect x="62" y="54" width="18" height="6" fill="#e53935"/><rect x="118" y="80" width="24" height="16" fill="#fff8e1" stroke="#a1887f"/>'}
 ,{id:'cay',href:'cay.html',c:'#ff8a3d',tag:'Yönetim · 8 gün',df:1,n:'Çay Ocağı',d:'Boğaz kıyısındaki çay ocağını sen işletiyorsun. Çay doldur, tostu tam zamanında çevir, simit ve ayran ver. Vapur gelince kuyruk uzar, sabırsız müşteri beklemez!',keys:'Fare/dokunma ya da klavye: 1 çay (basılı tut), 2 simit, 3 tost, 4 ayran, Boşluk servis.',
  svg:'<rect width="260" height="150" fill="#79c7ec"/><rect y="92" width="260" height="58" fill="#c9b48a"/><rect x="20" y="40" width="220" height="14" fill="#c62828"/><rect x="20" y="40" width="30" height="14" fill="#fff"/><rect x="80" y="40" width="30" height="14" fill="#fff"/><rect x="140" y="40" width="30" height="14" fill="#fff"/><rect x="200" y="40" width="30" height="14" fill="#fff"/><rect x="20" y="54" width="220" height="44" fill="#7a5a3a"/><rect x="14" y="88" width="232" height="14" fill="#c28a52"/><ellipse cx="60" cy="82" rx="12" ry="9" fill="#c0392b"/><circle cx="130" cy="82" r="10" fill="none" stroke="#d28a2b" stroke-width="5"/><rect x="190" y="70" width="26" height="22" fill="#dfe9f0"/><circle cx="90" cy="118" r="8" fill="#e8b98f"/><rect x="82" y="124" width="16" height="18" fill="#3b6fb6"/><circle cx="170" cy="118" r="8" fill="#d99b6c"/><rect x="162" y="124" width="16" height="18" fill="#2e8b57"/>'}
 ,{id:'yol',href:'yol.html',c:'#ff4d6a',tag:'Yarış · sonsuz yol',df:1,n:'Yol Yarışı',d:'Üç şeritli yolda arabanı sür. Trafiğin arasından geç, para topla, nitroyla hızlan. Kalbin bitmeden en uzak yola git!',keys:'Ok tuşları ya da A D şerit değiştirir, Boşluk nitro, P duraklat. Dokunmatik: ekranın sol ve sağ altı.',
  svg:'<rect width="260" height="150" fill="#6fb6e8"/><path d="M95 150L125 60h10l30 90z" fill="#3a3f4a"/><path d="M130 62v88" stroke="#fff" stroke-width="3" stroke-dasharray="10 8"/><rect x="108" y="100" width="22" height="36" rx="5" fill="#e53935"/><rect x="140" y="84" width="18" height="30" rx="4" fill="#ffd54f"/><circle cx="60" cy="40" r="14" fill="#fff" opacity=".8"/>'}
 ,{id:'sehir',href:'sehir.html',c:'#26a69a',tag:'Şehir kurma · her gün gel',df:0,n:'Mahalle Kur',d:'Boş arsalara ev, dükkan, park yap. Kıyıya iskele kur, iki iskeleyle vapur hattı aç. Oyun kapalıyken de para birikir!',keys:'Fare ya da dokunma: arsaya bas, bina seç. Yükselt, topla.',
  svg:'<rect width="260" height="150" fill="#9be3ff"/><rect y="105" width="260" height="45" fill="#2a8fc9"/><rect y="60" width="260" height="50" fill="#7fcf6a"/><rect x="24" y="50" width="40" height="42" rx="5" fill="#ef9a9a"/><rect x="76" y="38" width="36" height="54" rx="5" fill="#90a4ae"/><rect x="124" y="56" width="40" height="36" rx="5" fill="#ffcc80"/><circle cx="196" cy="70" r="18" fill="#2e9e4f"/><rect x="40" y="96" width="34" height="8" fill="#c9a56a"/><rect x="150" y="96" width="34" height="8" fill="#c9a56a"/>'}
 ,{id:'balik',href:'balikci.html',c:'#29b6f6',tag:'Balık tutma · 5 bölge',df:0,n:'Balıkçı',d:'Oltayı balığa yaklaştır, ısırınca makarayı çevir. Para kazan, yeni bölge aç, yem ve olta geliştir. Boğaz’dan tropiklere!',keys:'Fare ya da ok tuşlarıyla olta, Boşluk (ya da tık basılı) makara. Dokunmatik: sürükle, basılı tut.',
  svg:'<rect width="260" height="150" fill="#bfe6ff"/><rect y="50" width="260" height="100" fill="#2a8fc9"/><rect y="100" width="260" height="50" fill="#14608f"/><path d="M60 40 L120 40 L112 62 L68 62Z" fill="#8b4513"/><path d="M96 40 L150 8" stroke="#555" stroke-width="3"/><path d="M150 8 Q170 60 160 98" stroke="#fff" fill="none"/><ellipse cx="150" cy="108" rx="26" ry="12" fill="#ffb74d"/><path d="M124 108 L108 98 L108 118Z" fill="#ffb74d"/><circle cx="162" cy="105" r="3" fill="#111"/><ellipse cx="62" cy="120" rx="18" ry="8" fill="#90a4ae"/><path d="M44 120 L34 113 L34 127Z" fill="#90a4ae"/>'}
];
var st={k:'',q:''};
try{var p=new URLSearchParams(location.search);if(p.has('k')||p.has('q')){st.k=p.get('k')||'';st.q=p.get('q')||'';}else{st.k=localStorage.getItem('nano:k')||'';var sq=localStorage.getItem('nano:q');if(sq===null){sq=((navigator.maxTouchPoints>0&&(navigator.hardwareConcurrency||8)<=4)||(navigator.deviceMemory||8)<=2)?'low':'';}st.q=sq;}}catch(e){}
function qs(){var a=[];if(st.k)a.push('k='+st.k);if(st.q)a.push('q='+st.q);return a.length?'?'+a.join('&'):'';}
function render(){
  var h='';GAMES.forEach(function(g){
    h+='<article class="card" style="--c:'+g.c+'"><div class="pic"><svg viewBox="0 0 260 150" preserveAspectRatio="xMidYMid slice" aria-hidden="true">'+g.svg+'</svg></div><div class="body"><div class="tag">'+g.tag+(g.lib?'<span class="badge">3B · three.js</span>':'<span class="badge">3B · internetsiz</span>')+(g.df?'<span class="badge">Kolay · Orta · Zor</span>':'')+'</div><h3>'+g.n+'</h3><p>'+g.d+'</p><div class="keys">'+g.keys+'</div><a class="play" href="#" data-g="'+g.id+'">Oyna</a></div></article>';
  });
  document.getElementById('games').innerHTML=h;
  try{if(navigator.maxTouchPoints>0&&Math.min(screen.width,screen.height)<600){var k2=document.querySelector('a[data-h="kacak2.html"],a[data-g="kacak2"]');if(k2){k2.removeAttribute('data-g');k2.removeAttribute('data-h');k2.removeAttribute('href');k2.textContent='Bilgisayar ve tahta için';k2.style.opacity='.55';k2.style.pointerEvents='none';}}}catch(e){}
  psum();
}
function psum(){try{var P=NP.get(),n=Object.keys(P.badges).length,t=Object.keys(NP.BADGES).length,r=Object.keys(P.rec).length;document.getElementById('pst').innerHTML='<div><b>🪙 '+P.coins+'</b><span>Paran</span></div><div><b>🏅 '+n+' / '+t+'</b><span>Rozet</span></div><div><b>🏆 '+r+'</b><span>Rekor kaydı</span></div><div><b>🎩 '+(P.owned.length-1)+'</b><span>Aldığın kostüm</span></div>';}catch(e){}}
function mark(id,v){var b=document.querySelectorAll('#'+id+' button');for(var i=0;i<b.length;i++)b[i].setAttribute('aria-pressed',b[i].getAttribute('data-v')===v?'true':'false');}
function bind(id,key){var s=document.getElementById(id);s.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;st[key]=b.getAttribute('data-v');try{localStorage.setItem('nano:'+key,st[key]);}catch(x){}mark(id,st[key]);render();});mark(id,st[key]);}
bind('segK','k');bind('segQ','q');render();
document.getElementById('prof').addEventListener('click',function(){NP.openProfile(psum);});
document.getElementById('fs').addEventListener('click',function(){var d=document.documentElement;try{if(document.fullscreenElement)document.exitFullscreen();else if(d.requestFullscreen)d.requestFullscreen().catch(function(){});}catch(e){}});
NP.whatsNew('2026-10-19','Yeni güncelleme geldi!',[['🎣','Yeni oyun: Balıkçı','5 bölge, yem ve olta geliştirme, makara mini oyunu, hazine sandığı ve altın balık. Yönergesi içinde.'],['🏙️','Yeni oyun: Mahalle Kur','Ev, dükkan, park yap; iskele kurup vapur hattı aç. Oyun kapalıyken de para birikir.'],['👥','Poyraz: 2 oyuncu','Başlıkta “2 oyuncu” seç. Biri A D W, öbürü ok tuşları. (Telefonda yok)'],['📲','Uygulama gibi yükle','İnternetsiz de açılır. Menüde “Uygulama olarak yükle”.'],['🔋','Pil tasarrufu','Menüde Grafik → Pil tasarrufu.'],['🎮','Kaçak: 2 oyuncu yarışı ve 35 görev','Kim görevleri önce bitirecek? Menüde Kaçak’ın yanında.']]);
try{if(NP.dailyReady()){setTimeout(function(){NP.toast('Günlük ödülün hazır','🎁','Profil → Günlük bölümünden al');},1200);}}catch(e){}
try{if('serviceWorker' in navigator&&/^https?:/.test(location.protocol)){navigator.serviceWorker.register('sw.js').then(function(){return navigator.serviceWorker.ready;}).then(function(){if(!localStorage.getItem('nano:offl')){localStorage.setItem('nano:offl','1');setTimeout(function(){NP.toast('İnternetsiz kullanıma hazır','📲','Bir kez açıldı, artık internetsiz de açılır');},2500);}}).catch(function(){});}}catch(e){}
var _ip=null;window.addEventListener('beforeinstallprompt',function(e){e.preventDefault();_ip=e;var b=document.getElementById('inst');if(b)b.style.display='block';});
(function(){var b=document.createElement('button');b.id='inst';b.textContent='📲 Uygulama olarak yükle';b.style.cssText='display:none;position:fixed;right:12px;bottom:12px;z-index:50;font:700 15px system-ui;padding:10px 16px;border-radius:14px;border:0;background:#ffb300;color:#222;cursor:pointer';b.onclick=function(){if(_ip){_ip.prompt();_ip=null;b.style.display='none';}};document.body.appendChild(b);})();

var __G={"metrobus": "", "kacak": "", "sifir": "", "liman": "", "poyraz": "", "cay": "", "yol": "", "sehir": "", "balik": "", "kacak2": ""};
function __dec(b){var bin=atob(b),u=new Uint8Array(bin.length);for(var i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);return new TextDecoder('utf-8').decode(u);}
window.NANO_GO=function(id){try{if(window.speechSynthesis)speechSynthesis.cancel();}catch(e){}window.__NQ=qs();try{if(navigator.maxTouchPoints>0&&!document.fullscreenElement){document.documentElement.requestFullscreen().then(function(){try{screen.orientation.lock('landscape').catch(function(){});}catch(e){}}).catch(function(){});}}catch(e){}var h=__dec(__G[id]);document.open();document.write(h);document.close();};
window.NANO_KACAK=function(){return __dec(__G['kacak']);};
window.NANO_HOME=function(){try{if(window.speechSynthesis)speechSynthesis.cancel();}catch(e){}location.reload();};
document.getElementById('games').addEventListener('click',function(e){var a=e.target.closest('a[data-g]');if(!a)return;e.preventDefault();NANO_GO(a.getAttribute('data-g'));});
</script>
</body></html>
