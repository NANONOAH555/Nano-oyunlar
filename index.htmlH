<!doctype html>
<html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Nano Oyunlar</title>
<link rel="manifest" href="manifest.json"><meta name="theme-color" content="#0b1230"><link rel="apple-touch-icon" href="icon-192.png">
<style>
/* Düzen: Yenikapı gece hattı. Dikey bir metro hattı, her durak bir oyun. */
:root{--bg:#0a0f1f;--panel:#121a33;--panel2:#18224a;--fg:#eef1ff;--mut:#9aa6d6;--line:#2b3a78;--gold:#ffc83d;--red:#ff5a4f;--green:#46d37f;--blue:#4aa8ff;--violet:#a47bff;color-scheme:dark}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%}
body{background:var(--bg);color:var(--fg);font:16px/1.5 system-ui,"Segoe UI",Roboto,"DejaVu Sans",Arial,sans-serif;padding-inline:18px;padding-block:22px 48px}
.wrap{max-width:1100px;margin:0 auto}
header{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:14px;margin-bottom:22px}
h1{margin:0;font-size:clamp(34px,6vw,60px);line-height:1;letter-spacing:-.02em;text-wrap:balance}
h1 span{color:var(--gold)}
.sub{margin:8px 0 0;color:var(--mut);max-width:46ch}
.bar{display:flex;flex-wrap:wrap;gap:10px}
button,.btn{font:inherit;cursor:pointer}
.settings{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:16px;margin-bottom:28px}
.settings h2{margin:0 0 8px;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--mut);font-weight:700}
.seg{display:flex;gap:6px;flex-wrap:wrap}
.seg button{flex:1;min-width:90px;min-height:52px;padding:8px 12px;border-radius:12px;border:2px solid var(--line);background:var(--panel2);color:var(--fg);font-weight:600;font-size:16px}
.seg button[aria-pressed="true"]{background:var(--gold);color:#1a1400;border-color:var(--gold)}
.seg button:focus-visible,.card a:focus-visible,.fs:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
.fs{min-height:52px;padding:10px 18px;border-radius:12px;border:2px solid var(--line);background:var(--panel2);color:var(--fg);font-weight:600}
.hint{font-size:14px;color:var(--mut);margin:8px 0 0}
.line{position:relative;display:grid;gap:18px;padding-left:46px}
.line::before{content:"";position:absolute;left:17px;top:18px;bottom:18px;width:8px;border-radius:4px;background:linear-gradient(var(--red),var(--gold),var(--green),var(--blue),var(--violet))}
.card{position:relative;display:grid;grid-template-columns:minmax(0,260px) minmax(0,1fr);gap:0;background:var(--panel);border:1px solid var(--line);border-radius:20px}
.card::before{content:"";position:absolute;left:-37px;top:50%;width:26px;height:26px;margin-top:-13px;border-radius:50%;background:var(--bg);border:6px solid var(--c)}
.card .pic{background:var(--panel2);min-height:150px;border-radius:19px 0 0 19px;overflow:hidden}
.card .pic svg{display:block;width:100%;height:100%}
.card .body{padding:16px 18px 18px;display:flex;flex-direction:column;gap:6px;min-width:0}
.tag{font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:var(--c)}
.card h3{margin:0;font-size:26px;line-height:1.15}
.card p{margin:0;color:var(--mut)}
.card .keys{font-size:14px;color:var(--mut)}
.play{margin-top:auto;align-self:flex-start;display:inline-flex;align-items:center;min-height:52px;padding:10px 26px;border-radius:14px;background:var(--c);color:#0a0f1f;font-weight:800;font-size:18px;text-decoration:none}
.play:hover{filter:brightness(1.1)}
.badge{display:inline-block;margin-left:8px;font-size:12px;padding:2px 8px;border-radius:99px;background:var(--panel2);border:1px solid var(--line);color:var(--mut);letter-spacing:0;text-transform:none;font-weight:600}
.pst{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:18px}
.pst div{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:10px 14px}
.pst b{display:block;font-size:26px;color:var(--gold);line-height:1.2}
.pst span{font-size:13px;color:var(--mut)}
details{margin-top:30px;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:14px 18px}
summary{cursor:pointer;font-weight:700;min-height:32px}
details p,details li{color:var(--mut)}
code{background:var(--panel2);padding:1px 6px;border-radius:6px;color:var(--fg)}
@media(max-width:640px){.card{grid-template-columns:1fr}.card .pic{height:150px;border-radius:19px 19px 0 0}.line{padding-left:34px}.line::before{left:11px}.card::before{left:-30px;width:20px;height:20px;margin-top:-10px;border-width:5px}}
@media(prefers-reduced-motion:no-preference){.card{transition:transform .15s}.card:hover{transform:translateX(4px)}}
</style></head><body>
<div class="wrap">
<header>
  <div><h1>Nano <span>Oyunlar</span></h1><p class="sub">On oyun, hepsi 3 boyutlu. Kazandıkça para, rozet ve rekor topla; kostüm al. Klavyeyle, dokunmatik ekranla ya da akıllı tahtayla oynanır.</p></div>
  <div class="bar"><button class="fs" id="prof" type="button" style="background:var(--gold);color:#1a1400;border-color:var(--gold)">👤 Profil · Mağaza</button><button class="fs" id="fs" type="button">Tam ekran</button></div>
</header>

<section class="pst" id="pst" aria-label="Profil özeti"></section>

<section class="settings" aria-label="Ayarlar">
  <div><h2>Kontrol</h2>
    <div class="seg" id="segK" role="group" aria-label="Kontrol seçimi">
      <button type="button" data-v="" aria-pressed="true">Otomatik</button>
      <button type="button" data-v="key" aria-pressed="false">Klavye</button>
      <button type="button" data-v="touch" aria-pressed="false">Dokunmatik / Tahta</button>
    </div>
    <p class="hint">Otomatik: cihaz dokunmatikse ekran düğmeleri açılır. Klavyeli tahtada “Klavye” seç.</p></div>
  <div><h2>Grafik</h2>
    <div class="seg" id="segQ" role="group" aria-label="Grafik seçimi">
      <button type="button" data-v="" aria-pressed="true">Normal</button>
      <button type="button" data-v="low" aria-pressed="false">Hafif (yavaş cihaz)</button>
      <button type="button" data-v="saver" aria-pressed="false">Pil tasarrufu</button>
    </div>
    <p class="hint">Oyun takılıyorsa “Hafif” seç. Gölgeler kapanır, oyun hızlanır.</p></div>
</section>

<main class="line" id="games"></main>

<details>
  <summary>Flash bellekte nasıl açılır?</summary>
  <ol>
    <li>Zip dosyasını flash belleğe aç. Klasörün içinde <code>index.html</code> var.</li>
    <li>Pardus’ta <code>index.html</code>’e çift tıkla ya da Firefox / Chrome ile aç.</li>
    <li>Sıfır Durak, Martı Nöbeti ve Poyraz internetsiz çalışır.</li>
    <li>Metrobüs ve Kaçak için <code>lib/three.min.js</code> dosyası gerekir. Dosya yoksa oyun internetten çeker. README.txt’de nereden indirileceği yazıyor.</li>
  </ol>
</details>
</div>

<script>/* Nano Oyunlar - ortak profil (NP): para, rozet, rekor, kostüm, ses efektleri, profil ekranı. Her sayfada tek başına çalışır. */
(function(){
if (window.NP) return;
const NP = window.NP = {};
const KEY = 'nano:profile:v1';
const D = () => ({ name: 'Nano', coins: 0, earned: 0, badges: {}, rec: {}, stat: {}, owned: ['c:orijinal'], worn: { hat: null, face: null, back: null, neck: null, color: 'c:orijinal' }, mute: false });
let P = null;
function load(){ try { const s = localStorage.getItem(KEY); P = s ? Object.assign(D(), JSON.parse(s)) : D(); } catch (_) { P = D(); } if (!P.owned.includes('c:orijinal')) P.owned.push('c:orijinal'); }
function save(){ try { localStorage.setItem(KEY, JSON.stringify(P)); } catch (_) {} }
load();
NP.get = () => { load(); return P; };
NP.coins = () => { load(); return P.coins; };

/* ---------- katalog ---------- */
const hex = c => c;
NP.SHOP = {
  hat: [
    { id: 'h:kep', n: 'Kep', p: 40, parts: [{ s: 'sph', p: [0, .5, 0], z: [1.1, .62, 1.1], c: '#e53935' }, { s: 'box', p: [0, .42, 1.05], z: [1.3, .1, .8], c: '#b71c1c' }] },
    { id: 'h:fes', n: 'Fes', p: 60, parts: [{ s: 'cyl', p: [0, 1.0, 0], z: [.78, .95], c: '#c62828' }, { s: 'sph', p: [.62, 1.2, 0], z: [.14, .14, .14], c: '#111' }, { s: 'box', p: [.62, .85, 0], z: [.06, .5, .06], c: '#111' }] },
    { id: 'h:kask', n: 'İş kaskı', p: 70, parts: [{ s: 'sph', p: [0, .45, 0], z: [1.12, .85, 1.12], c: '#ffca28' }, { s: 'box', p: [0, .3, 1.05], z: [1.4, .1, .5], c: '#f9a825' }] },
    { id: 'h:cicek', n: 'Çiçek', p: 50, parts: [{ s: 'sph', p: [0, 1.15, 0], z: [.3, .3, .3], c: '#ffeb3b' }, { s: 'sph', p: [.38, 1.15, 0], z: [.26, .26, .26], c: '#f06292' }, { s: 'sph', p: [-.38, 1.15, 0], z: [.26, .26, .26], c: '#f06292' }, { s: 'sph', p: [0, 1.5, 0], z: [.26, .26, .26], c: '#f06292' }, { s: 'sph', p: [0, .8, 0], z: [.26, .26, .26], c: '#f06292' }] },
    { id: 'h:kovboy', n: 'Kovboy şapkası', p: 90, parts: [{ s: 'cyl', p: [0, .78, 0], z: [1.8, .12], c: '#8d6e63' }, { s: 'cyl', p: [0, 1.15, 0], z: [.85, .75], c: '#6d4c41' }] },
    { id: 'h:korsan', n: 'Korsan şapkası', p: 120, parts: [{ s: 'cyl', p: [0, .85, 0], z: [1.15, .5], c: '#212121' }, { s: 'box', p: [0, 1.15, 0], z: [1.9, .35, .4], c: '#212121' }, { s: 'box', p: [0, .9, 1.1], z: [.35, .3, .1], c: '#fafafa' }] },
    { id: 'h:silindir', n: 'Silindir şapka', p: 110, parts: [{ s: 'cyl', p: [0, .72, 0], z: [1.3, .1], c: '#212121' }, { s: 'cyl', p: [0, 1.4, 0], z: [.8, 1.3], c: '#212121' }, { s: 'cyl', p: [0, .95, 0], z: [.83, .22], c: '#d32f2f' }] },
    { id: 'h:tac', n: 'Altın taç', p: 220, parts: [{ s: 'cyl', p: [0, .95, 0], z: [.92, .45], c: '#ffc107' }, { s: 'cone', p: [.6, 1.35, 0], z: [.22, .5], c: '#ffc107' }, { s: 'cone', p: [-.6, 1.35, 0], z: [.22, .5], c: '#ffc107' }, { s: 'cone', p: [0, 1.45, 0], z: [.25, .65], c: '#ffc107' }, { s: 'sph', p: [0, 1.0, .9], z: [.15, .15, .15], c: '#e91e63' }] }
  ],
  face: [
    { id: 'f:gozluk', n: 'Siyah gözlük', p: 50, parts: [{ s: 'box', p: [-.42, .12, .98], z: [.6, .38, .12], c: '#111' }, { s: 'box', p: [.42, .12, .98], z: [.6, .38, .12], c: '#111' }, { s: 'box', p: [0, .16, .98], z: [.3, .08, .1], c: '#111' }] },
    { id: 'f:ayna', n: 'Mavi cam gözlük', p: 60, parts: [{ s: 'box', p: [-.42, .12, .98], z: [.6, .4, .12], c: '#29b6f6' }, { s: 'box', p: [.42, .12, .98], z: [.6, .4, .12], c: '#29b6f6' }, { s: 'box', p: [0, .16, .98], z: [.3, .08, .1], c: '#fff' }] },
    { id: 'f:biyik', n: 'Bıyık', p: 40, parts: [{ s: 'box', p: [-.3, -.33, 1.0], z: [.6, .14, .12], c: '#3e2723' }, { s: 'box', p: [.3, -.33, 1.0], z: [.6, .14, .12], c: '#3e2723' }] },
    { id: 'f:burun', n: 'Palyaço burnu', p: 30, parts: [{ s: 'sph', p: [0, -.08, 1.05], z: [.24, .24, .24], c: '#e53935' }] },
    { id: 'f:maske', n: 'Maske', p: 70, parts: [{ s: 'box', p: [0, -.4, .95], z: [1.7, .7, .2], c: '#eceff1' }, { s: 'box', p: [0, -.4, 1.06], z: [1.7, .08, .06], c: '#90caf9' }] }
  ],
  back: [
    { id: 'b:canta', n: 'Sırt çantası', p: 60, parts: [{ s: 'box', p: [0, -1.7, -.95], z: [1.2, 1.4, .5], c: '#6d4c41' }] },
    { id: 'b:pelerin', n: 'Kırmızı pelerin', p: 100, parts: [{ s: 'box', p: [0, -1.9, -.95], z: [1.7, 2.3, .12], c: '#d32f2f' }] },
    { id: 'b:jet', n: 'Jet paketi', p: 150, parts: [{ s: 'cyl', p: [-.45, -1.7, -1.0], z: [.3, 1.3], c: '#90a4ae' }, { s: 'cyl', p: [.45, -1.7, -1.0], z: [.3, 1.3], c: '#90a4ae' }, { s: 'cone', p: [-.45, -2.5, -1.0], z: [.25, .5], c: '#ff9800' }, { s: 'cone', p: [.45, -2.5, -1.0], z: [.25, .5], c: '#ff9800' }] },
    { id: 'b:kanat', n: 'Melek kanadı', p: 190, parts: [{ s: 'box', p: [-1.2, -1.2, -.85], z: [1.4, 1.9, .1], c: '#fafafa' }, { s: 'box', p: [1.2, -1.2, -.85], z: [1.4, 1.9, .1], c: '#fafafa' }] }
  ],
  color: [
    { id: 'c:orijinal', n: 'Orijinal', p: 0, col: null },
    { id: 'c:mavi', n: 'Mavi', p: 30, col: '#1e88e5' },
    { id: 'c:yesil', n: 'Yeşil', p: 30, col: '#43a047' },
    { id: 'c:pembe', n: 'Pembe', p: 40, col: '#ec407a' },
    { id: 'c:mor', n: 'Mor', p: 60, col: '#8e24aa' },
    { id: 'c:siyah', n: 'Siyah', p: 80, col: '#263238' },
    { id: 'c:altin', n: 'Altın', p: 250, col: '#ffc107' }
  ]
};
NP.SLOT_N = { hat: 'Şapka', face: 'Yüz', neck: 'Boyun (atkı, papyon, madalya, zincir)', back: 'Sırt', color: 'Renk' };
NP.SHOP.neck = [
  { id: 'n:atki', n: 'Kırmızı atkı', p: 45, parts: [{ s: 'box', p: [0, -1.0, 0], z: [2.5, .75, 2.3], c: '#e53935' }, { s: 'box', p: [0, -1.0, 1.16], z: [2.5, .16, .05], c: '#ffffff' }, { s: 'box', p: [.75, -2.0, 1.15], z: [.75, 1.6, .25], c: '#e53935' }, { s: 'box', p: [.75, -2.0, 1.29], z: [.75, .16, .05], c: '#ffffff' }] },
  { id: 'n:papyon', n: 'Papyon', p: 55, parts: [{ s: 'box', p: [-.6, -1.15, 1.05], z: [.95, .75, .3], c: '#1565c0' }, { s: 'box', p: [.6, -1.15, 1.05], z: [.95, .75, .3], c: '#1565c0' }, { s: 'sph', p: [0, -1.15, 1.1], z: [.3, .3, .25], c: '#0d47a1' }] },
  { id: 'n:zincir', n: 'Altın zincir', p: 140, parts: [{ s: 'sph', p: [-.95, -1.0, .75], z: [.17, .17, .17], c: '#ffc107' }, { s: 'sph', p: [.95, -1.0, .75], z: [.17, .17, .17], c: '#ffc107' }, { s: 'sph', p: [-.65, -1.3, 1.0], z: [.17, .17, .17], c: '#ffc107' }, { s: 'sph', p: [.65, -1.3, 1.0], z: [.17, .17, .17], c: '#ffc107' }, { s: 'sph', p: [-.3, -1.5, 1.08], z: [.17, .17, .17], c: '#ffc107' }, { s: 'sph', p: [.3, -1.5, 1.08], z: [.17, .17, .17], c: '#ffc107' }, { s: 'sph', p: [0, -1.95, 1.1], z: [.5, .5, .2], c: '#ffeb3b' }] },
  { id: 'n:madalya', n: 'Madalya', p: 90, parts: [{ s: 'box', p: [-.35, -1.25, 1.0], z: [.4, 1.0, .1], c: '#1e88e5' }, { s: 'box', p: [.35, -1.25, 1.0], z: [.4, 1.0, .1], c: '#e53935' }, { s: 'sph', p: [0, -2.0, 1.1], z: [.6, .6, .16], c: '#ffd54f' }, { s: 'sph', p: [0, -2.0, 1.22], z: [.3, .3, .06], c: '#fff8e1' }] }
];
NP.SHOP.hat.push(
  { id: 'h:bere', n: 'Beyaz bere', p: 35, parts: [{ s: 'sph', p: [0, .5, 0], z: [1.12, .75, 1.12], c: '#f5f5f5' }, { s: 'sph', p: [0, 1.25, 0], z: [.3, .3, .3], c: '#ef5350' }] },
  { id: 'h:sef', n: 'Şef şapkası', p: 80, parts: [{ s: 'cyl', p: [0, .75, 0], z: [.9, .5], c: '#fafafa' }, { s: 'sph', p: [0, 1.35, 0], z: [1.15, .8, 1.15], c: '#ffffff' }] },
  { id: 'h:sihirbaz', n: 'Sihirbaz şapkası', p: 130, parts: [{ s: 'cyl', p: [0, .7, 0], z: [1.5, .1], c: '#4527a0' }, { s: 'cone', p: [0, 1.7, 0], z: [.95, 2.0], c: '#5e35b1' }, { s: 'sph', p: [.3, 1.2, 1.0], z: [.2, .2, .1], c: '#ffeb3b' }, { s: 'sph', p: [-.25, 1.8, .6], z: [.15, .15, .1], c: '#ffeb3b' }] },
  { id: 'h:viking', n: 'Boynuzlu miğfer', p: 140, parts: [{ s: 'sph', p: [0, .45, 0], z: [1.12, .8, 1.12], c: '#90a4ae' }, { s: 'cone', p: [1.15, 1.0, 0], z: [.3, 1.1], c: '#fff8e1' }, { s: 'cone', p: [-1.15, 1.0, 0], z: [.3, 1.1], c: '#fff8e1' }] },
  { id: 'h:kulaklik', n: 'Kulaklık', p: 75, parts: [{ s: 'box', p: [0, 1.05, 0], z: [2.3, .18, .3], c: '#263238' }, { s: 'cyl', p: [-1.1, .1, 0], z: [.55, .4], c: '#e53935' }, { s: 'cyl', p: [1.1, .1, 0], z: [.55, .4], c: '#e53935' }, { s: 'box', p: [-1.1, .6, 0], z: [.18, 1.0, .25], c: '#263238' }, { s: 'box', p: [1.1, .6, 0], z: [.18, 1.0, .25], c: '#263238' }] },
  { id: 'h:gokkusagi', n: 'Gökkuşağı bere', p: 160, parts: [{ s: 'sph', p: [0, .5, 0], z: [1.14, .7, 1.14], c: '#e53935' }, { s: 'sph', p: [0, .72, 0], z: [1.0, .5, 1.0], c: '#ffb300' }, { s: 'sph', p: [0, .9, 0], z: [.8, .36, .8], c: '#43a047' }, { s: 'sph', p: [0, 1.2, 0], z: [.3, .3, .3], c: '#1e88e5' }] }
);
NP.SHOP.face.push(
  { id: 'f:kalp', n: 'Kalp gözlük', p: 85, parts: [{ s: 'sph', p: [-.45, .12, .98], z: [.34, .34, .1], c: '#ec407a' }, { s: 'sph', p: [.45, .12, .98], z: [.34, .34, .1], c: '#ec407a' }, { s: 'box', p: [0, .16, .98], z: [.3, .08, .1], c: '#ad1457' }] },
  { id: 'f:sakal', n: 'Gür sakal', p: 95, parts: [{ s: 'box', p: [0, -.62, .85], z: [1.4, .8, .45], c: '#4e342e' }, { s: 'box', p: [0, -.25, 1.0], z: [.9, .14, .12], c: '#3e2723' }] },
  { id: 'f:ninja', n: 'Ninja bandı', p: 110, parts: [{ s: 'box', p: [0, .3, .92], z: [2.1, .5, .3], c: '#212121' }, { s: 'box', p: [-.4, .32, 1.1], z: [.4, .14, .1], c: '#fafafa' }, { s: 'box', p: [.4, .32, 1.1], z: [.4, .14, .1], c: '#fafafa' }] },
  { id: 'f:vr', n: 'Gelecek gözlüğü', p: 150, parts: [{ s: 'box', p: [0, .12, 1.0], z: [1.9, .55, .3], c: '#37474f' }, { s: 'box', p: [0, .12, 1.17], z: [1.6, .3, .05], c: '#00e5ff' }] }
);
NP.SHOP.back.push(
  { id: 'b:gokk', n: 'Mavi pelerin', p: 120, parts: [{ s: 'box', p: [0, -1.9, -.95], z: [1.7, 2.3, .12], c: '#1565c0' }, { s: 'box', p: [0, -.95, -.9], z: [1.9, .2, .2], c: '#ffc107' }] },
  { id: 'b:balon', n: 'Kırmızı balon', p: 70, parts: [{ s: 'box', p: [.9, -.2, -.9], z: [.06, 2.6, .06], c: '#eee' }, { s: 'sph', p: [.9, 1.6, -.9], z: [.7, .85, .7], c: '#e53935' }] },
  { id: 'b:kilic', n: 'Sırtta kılıç', p: 100, parts: [{ s: 'box', p: [.2, -1.4, -.95], z: [.2, 2.6, .12], c: '#cfd8dc' }, { s: 'box', p: [.2, -.1, -.95], z: [.9, .16, .16], c: '#8d6e63' }] }
);
NP.SHOP.color.push(
  { id: 'c:turuncu', n: 'Turuncu', p: 30, col: '#fb8c00' },
  { id: 'c:kirmizi', n: 'Kırmızı', p: 35, col: '#e53935' },
  { id: 'c:turkuaz', n: 'Turkuaz', p: 45, col: '#00acc1' },
  { id: 'c:beyaz', n: 'Beyaz', p: 60, col: '#f5f5f5' }
);
NP.item = id => { for (const k in NP.SHOP) { const it = NP.SHOP[k].find(i => i.id === id); if (it) return it; } return null; };
/* giyilen kostüm: { color: '#hex'|null, parts: [{s,p,z,c}] } (kafa yarıçapı = 1, +z ileri, +y yukarı, kafa merkezine göre) */
NP.SCALE = 1.35;
NP.look = (ov) => { load(); ov = ov || {}; const parts = [], has = {}; let color = null, sc = NP.SCALE;
  ['hat', 'face', 'neck', 'back'].forEach(k => { const id = (k in ov) ? ov[k] : P.worn[k]; const it = id && NP.item(id); if (it && ((k in ov) || P.owned.includes(it.id))) { has[k] = 1; it.parts.forEach(q => parts.push({ s: q.s, c: q.c, p: [q.p[0] * sc, q.p[1] * sc, q.p[2] * sc], z: q.z.map(v => v * sc) })); } });
  const cid = ('color' in ov) ? ov.color : P.worn.color; const c = cid && NP.item(cid); if (c && c.col && (('color' in ov) || P.owned.includes(c.id))) color = c.col;
  return { color, parts, has }; };
NP.buy = id => { load(); const it = NP.item(id); if (!it || P.owned.includes(id)) return false; if (P.coins < it.p) { NP.sfx('bad'); return false; } P.coins -= it.p; P.owned.push(id); save(); NP.sfx('buy'); return true; };
NP.wear = (slot, id) => { load(); if (id && !P.owned.includes(id)) return false; P.worn[slot] = id; save(); NP.sfx('pick'); return true; };

/* ---------- rozetler ---------- */
NP.BADGES = {}; /* aşağıda doldurulur */
NP.badge = id => { load(); const b = NP.BADGES[id]; if (!b || P.badges[id]) return false; P.badges[id] = Date.now(); P.coins += b.c; P.earned += b.c; save(); NP.sfx('badge'); NP.toast('Rozet: ' + b.n, b.i, '+' + b.c + ' 🪙 · ' + b.d); return true; };
NP.has = id => { load(); return !!P.badges[id]; };
NP.addCoins = (n, quiet) => { n = Math.max(0, Math.floor(n)); if (!n) return 0; load(); P.coins += n; P.earned += n; save(); if (!quiet) NP.toast('+' + n + ' 🪙', '🪙', 'Kazanılan para: ' + P.coins); if (P.earned >= 500) NP.badge('gn_para'); return n; };
/* sayaçlar: rozet koşulları için */
NP.inc = (k, n = 1) => { load(); P.stat[k] = (P.stat[k] || 0) + n; save(); return P.stat[k]; };
NP.max = (k, v) => { load(); if (v > (P.stat[k] || 0)) { P.stat[k] = v; save(); } return P.stat[k] || 0; };
NP.stat = k => { load(); return P.stat[k] || 0; };
/* rekor: oyun, zorluk ('-' yoksa), puan. { best, isNew } */
NP.record = (game, diff, score) => { load(); const k = game + ':' + (diff || '-'); const old = (P.rec[k] || 0); const isNew = score > old; if (isNew) { P.rec[k] = Math.floor(score); save(); } return { best: Math.max(old, Math.floor(score)), isNew, old }; };
NP.best = (game, diff) => { load(); return P.rec[game + ':' + (diff || '-')] || 0; };
/* oyun sonu: puan kaydı + para. coins: kazanılan para. */
NP.spend = n => { load(); n = Math.floor(n); if (P.coins < n) return false; P.coins -= n; save(); return true; };
/* ---------- günlük ödül ve görevler ---------- */
const dayKey = () => { const d = new Date(); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); };
const QPOOL = [
  { t: 'fin', n: 3, x: 'Bugün 3 oyun bitir', r: 40 }, { t: 'fin', n: 5, x: 'Bugün 5 oyun bitir', r: 70 },
  { t: 'dist', n: 2, x: 'Bugün 2 farklı oyun oyna', r: 40 }, { t: 'dist', n: 3, x: 'Bugün 3 farklı oyun oyna', r: 70 },
  { t: 'earn', n: 80, x: 'Oyunlardan 80 🪙 kazan', r: 40 }, { t: 'earn', n: 200, x: 'Oyunlardan 200 🪙 kazan', r: 80 },
  { t: 'score', g: 'yol', n: 1200, x: 'Yol Yarışı’nda 1200 puan yap', r: 60 }, { t: 'score', g: 'cay', n: 500, x: 'Çay Ocağı’nda 500 puan yap', r: 60 },
  { t: 'fin1', g: 'liman', n: 1, x: 'Martı Nöbeti’ni bir kez bitir', r: 50 }, { t: 'fin1', g: 'poyraz', n: 1, x: 'Poyraz’ı bir kez bitir', r: 50 }, { t: 'fin1', g: 'sifir', n: 1, x: 'Sıfır Durak’ta bir oyun bitir', r: 50 }
];
function dailyGet(){ load(); const k = dayKey(); let d = P.daily;
  if (!d || d.day !== k) {
    let streak = 1; if (d) { const y = new Date(); y.setDate(y.getDate() - 1); const yk = y.getFullYear() + '-' + String(y.getMonth() + 1).padStart(2, '0') + '-' + String(y.getDate()).padStart(2, '0'); streak = d.day === yk && d.claimed ? (d.streak || 1) + 1 : 1; }
    let h = 0; for (const ch of k) h = (h * 31 + ch.charCodeAt(0)) >>> 0; const used = [], qs = [];
    while (qs.length < 3) { h = (h * 1103515245 + 12345) >>> 0; const q = QPOOL[(h >>> 8) % QPOOL.length]; const sig = q.t + (q.g || ''); if (used.includes(sig)) continue; used.push(sig); qs.push({ i: QPOOL.indexOf(q), p: 0, done: 0, got: 0, gm: [] }); }
    d = P.daily = { day: k, streak, claimed: 0, earn: 0, fin: 0, gm: [], qs }; save();
  } return d; }
NP.daily = () => dailyGet();
NP.dayKey = dayKey;
NP.dailyReward = () => 20 + 10 * Math.min(6, (dailyGet().streak || 1) - 1);
NP.dailyClaim = () => { const d = dailyGet(); if (d.claimed) return 0; d.claimed = 1; save(); const r = NP.dailyReward(); NP.addCoins(r, true); NP.toast('Günlük ödül', '🎁', '+' + r + ' 🪙 · seri: ' + d.streak + ' gün'); NP.sfx('badge'); return r; };
NP.questClaim = i => { const d = dailyGet(), q = d.qs[i]; if (!q || !q.done || q.got) return 0; q.got = 1; save(); const r = QPOOL[q.i].r; NP.addCoins(r, true); NP.toast('Görev tamam', '🎯', '+' + r + ' 🪙'); NP.sfx('ok'); return r; };
NP.questInfo = q => QPOOL[q.i];
function dailyTrack(game, score, coins){ const d = dailyGet(); d.fin++; if (!d.gm.includes(game)) d.gm.push(game); d.earn += coins || 0;
  d.qs.forEach(q => { const Q = QPOOL[q.i]; let p = q.p; if (Q.t === 'fin') p = d.fin; else if (Q.t === 'dist') p = d.gm.length; else if (Q.t === 'earn') p = d.earn; else if (Q.t === 'score') { if (game === Q.g) p = Math.max(p, score); } else if (Q.t === 'fin1') { if (game === Q.g) p = 1; } q.p = Math.min(Q.n, p); if (q.p >= Q.n && !q.done) { q.done = 1; NP.toast('Günlük görev bitti!', '🎯', Q.x + ' · Profil → Günlük'); } });
  save(); }
NP.dailyReady = () => { const d = dailyGet(); return !d.claimed || d.qs.some(q => q.done && !q.got); };
NP.finish = (game, diff, score, coins) => { const r = NP.record(game, diff, score); const c = NP.addCoins(coins || 0, true); if (c || r.isNew) NP.toast(r.isNew && score > 0 ? 'Yeni rekor: ' + Math.floor(score) : 'Oyun bitti', r.isNew ? '🏆' : '🪙', c ? '+' + c + ' 🪙 kazandın' : ''); r.coins = c; try { dailyTrack(game, score, c); } catch (_) {} return r; };

/* ---------- bildirim ---------- */
let tbox = null; const tq = []; let tbusy = false;
function ensureBox(){ if (tbox && tbox.isConnected) return tbox; tbox = document.createElement('div'); tbox.style.cssText = 'position:fixed;top:48px;left:50%;transform:translateX(-50%);z-index:2147483000;display:flex;flex-direction:column;gap:6px;align-items:center;pointer-events:none;font-family:system-ui,"Segoe UI",Roboto,Arial,sans-serif'; (document.body || document.documentElement).appendChild(tbox); return tbox; }
function nextToast(){ if (tbusy || !tq.length) return; tbusy = true; const t = tq.shift(); const box = ensureBox(); const el = document.createElement('div');
  el.style.cssText = 'background:rgba(18,26,51,.96);color:#fff;border:2px solid #ffc83d;border-radius:14px;padding:8px 16px 8px 12px;display:flex;gap:10px;align-items:center;box-shadow:0 6px 24px rgba(0,0,0,.5);opacity:0;transform:translateY(-10px);transition:all .25s;max-width:92vw';
  const ic = document.createElement('div'); ic.style.cssText = 'font-size:28px;line-height:1'; ic.textContent = t.i || '🏅';
  const tx = document.createElement('div'); const a = document.createElement('div'); a.style.cssText = 'font-weight:700;font-size:16px'; a.textContent = t.a; tx.appendChild(a);
  if (t.b) { const b = document.createElement('div'); b.style.cssText = 'font-size:13px;color:#ffd98a'; b.textContent = t.b; tx.appendChild(b); }
  el.appendChild(ic); el.appendChild(tx); box.appendChild(el);
  requestAnimationFrame(() => { el.style.opacity = 1; el.style.transform = 'none'; });
  setTimeout(() => { el.style.opacity = 0; setTimeout(() => { el.remove(); tbusy = false; nextToast(); }, 260); }, 2800); }
NP.toast = (a, i, b) => { tq.push({ a, i, b }); if (document.body) nextToast(); else addEventListener('DOMContentLoaded', nextToast); };

/* ---------- ses efektleri (WebAudio sentezi) ---------- */
let ac = null, master = null, noiseBuf = null;
NP.audio = () => { if (!ac) { try { ac = new (window.AudioContext || window.webkitAudioContext)(); master = ac.createGain(); master.gain.value = .9; master.connect(ac.destination); } catch (_) {} } if (ac && ac.state === 'suspended') ac.resume(); return ac; };
['pointerdown', 'keydown', 'touchstart'].forEach(e => addEventListener(e, () => NP.audio(), { passive: true }));
NP.mute = false; try { load(); NP.mute = !!P.mute; } catch (_) {}
NP.setMute = m => { NP.mute = !!m; load(); P.mute = NP.mute; save(); };
function tone(f, d, type, v, o){ o = o || {}; const t0 = ac.currentTime + (o.at || 0); const os = ac.createOscillator(), g = ac.createGain(); os.type = type || 'sine'; os.frequency.setValueAtTime(f, t0);
  if (o.to) os.frequency.exponentialRampToValueAtTime(Math.max(20, o.to), t0 + d);
  g.gain.setValueAtTime(.0001, t0); g.gain.exponentialRampToValueAtTime(v || .1, t0 + (o.atk || .01)); g.gain.exponentialRampToValueAtTime(.0001, t0 + d);
  os.connect(g); g.connect(master); os.start(t0); os.stop(t0 + d + .03); }
function noise(d, v, o){ o = o || {}; if (!noiseBuf) { noiseBuf = ac.createBuffer(1, ac.sampleRate, ac.sampleRate); const a = noiseBuf.getChannelData(0); for (let i = 0; i < a.length; i++) a[i] = Math.random() * 2 - 1; }
  const t0 = ac.currentTime + (o.at || 0); const s = ac.createBufferSource(); s.buffer = noiseBuf; s.loop = true; const f = ac.createBiquadFilter(); f.type = o.type || 'lowpass'; f.frequency.setValueAtTime(o.f || 1200, t0); if (o.fto) f.frequency.exponentialRampToValueAtTime(o.fto, t0 + d);
  const g = ac.createGain(); g.gain.setValueAtTime(v || .1, t0); g.gain.exponentialRampToValueAtTime(.0001, t0 + d); s.connect(f); f.connect(g); g.connect(master); s.start(t0); s.stop(t0 + d + .03); }
const FX = {
  tap: () => tone(420, .05, 'square', .04),
  ok: () => { tone(660, .09, 'triangle', .1); tone(880, .14, 'triangle', .1, { at: .08 }); },
  bad: () => { tone(180, .28, 'sawtooth', .09, { to: 90 }); },
  pick: () => { tone(520, .07, 'triangle', .09); tone(780, .09, 'triangle', .09, { at: .06 }); },
  coin: () => { tone(988, .07, 'square', .05); tone(1319, .16, 'square', .05, { at: .06 }); },
  jump: () => tone(300, .16, 'square', .05, { to: 640 }),
  land: () => { noise(.08, .08, { f: 500 }); },
  hit: () => { tone(220, .14, 'square', .1, { to: 90 }); noise(.1, .08, { f: 900 }); },
  boom: () => { noise(.6, .25, { f: 700, fto: 80 }); tone(90, .5, 'sawtooth', .15, { to: 35 }); },
  crash: () => { noise(.45, .3, { f: 1500, fto: 120 }); tone(120, .35, 'square', .12, { to: 50 }); },
  win: () => [523, 659, 784, 1046].forEach((f, i) => tone(f, .22, 'triangle', .11, { at: i * .12 })),
  lose: () => [392, 330, 262, 196].forEach((f, i) => tone(f, .26, 'sawtooth', .07, { at: i * .16 })),
  badge: () => { [784, 988, 1175, 1568].forEach((f, i) => tone(f, .2, 'triangle', .1, { at: i * .09 })); },
  buy: () => { tone(880, .08, 'square', .05); tone(1175, .08, 'square', .05, { at: .07 }); tone(1568, .2, 'square', .05, { at: .14 }); },
  shoot: () => { tone(900, .1, 'square', .04, { to: 300 }); },
  place: () => { tone(300, .08, 'triangle', .1); noise(.05, .05, { f: 800 }); },
  sell: () => { tone(700, .08, 'triangle', .08, { to: 400 }); },
  wave: () => { tone(330, .18, 'sawtooth', .07); tone(440, .18, 'sawtooth', .07, { at: .16 }); tone(660, .3, 'sawtooth', .07, { at: .32 }); },
  honk: () => { tone(310, .3, 'sawtooth', .08); tone(392, .3, 'sawtooth', .06); },
  door: () => { noise(.25, .1, { f: 600, fto: 200 }); tone(140, .2, 'square', .05, { to: 80 }); },
  siren: () => { tone(700, .35, 'sine', .06, { to: 950 }); tone(950, .35, 'sine', .06, { at: .35, to: 700 }); },
  ding: () => { tone(1040, .5, 'sine', .09); tone(1560, .4, 'sine', .04); },
  step: () => noise(.04, .05, { f: 400 }),
  splash: () => noise(.3, .12, { f: 2400, fto: 500 }),
  power: () => { tone(400, .3, 'sine', .09, { to: 1200 }); },
  alarm: () => { tone(880, .12, 'square', .07); tone(880, .12, 'square', .07, { at: .2 }); },
  page: () => { noise(.12, .05, { f: 3000, type: 'highpass' }); },
  miyav: () => { tone(650, .28, 'sine', .07, { to: 1050 }); tone(1050, .3, 'sine', .06, { at: .22, to: 560 }); },
  nitro: () => { noise(.5, .1, { f: 500, fto: 3000, type: 'bandpass' }); tone(200, .4, 'sawtooth', .05, { to: 500 }); },
  whoosh: () => noise(.3, .08, { f: 300, fto: 3000, type: 'bandpass' })
};
NP.sfx = (n, vol) => { if (NP.mute || window.NG && NG.mute) return; if (!NP.audio()) return; const f = FX[n]; if (!f) return; try { f(); } catch (_) {} };
NP.hasFx = n => !!FX[n];
/* motor sesi: sürekli çalan, hıza göre ton değiştiren (Metrobüs/Kaçak) */
let eng = null;
NP.engine = (on, speed01, kind) => { if (!NP.audio()) return; if (!on || NP.mute) { if (eng) { try { eng.g.gain.setTargetAtTime(0, ac.currentTime, .1); } catch (_) {} } return; }
  if (!eng) { const o = ac.createOscillator(), o2 = ac.createOscillator(), g = ac.createGain(), f = ac.createBiquadFilter(); o.type = 'sawtooth'; o2.type = 'square'; f.type = 'lowpass'; f.frequency.value = 380; g.gain.value = 0; o.connect(f); o2.connect(f); f.connect(g); g.connect(master); o.start(); o2.start(); eng = { o, o2, g, f }; }
  const s = Math.max(0, Math.min(1.2, speed01)); const base = kind === 'bus' ? 38 : 55; eng.o.frequency.setTargetAtTime(base + s * 70, ac.currentTime, .08); eng.o2.frequency.setTargetAtTime(base * .5 + s * 35, ac.currentTime, .08); eng.f.frequency.setTargetAtTime(260 + s * 380, ac.currentTime, .1); eng.g.gain.setTargetAtTime(.025 + s * .035, ac.currentTime, .1); };

